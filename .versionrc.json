{
  "header": "# Changelog\n\nChanges are grouped from Conventional Commit messages.\n",
  "packageFiles": ["package.json"],
  "bumpFiles": ["package.json", "package-lock.json"],
  "types": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "perf", "section": "Performance", "hidden": false },
    { "type": "revert", "section": "Reverts", "hidden": false },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "refactor", "section": "Refactoring", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": false },
    { "type": "build", "section": "Build System", "hidden": false },
    { "type": "ci", "section": "CI", "hidden": false },
    { "type": "chore", "section": "Maintenance", "hidden": false },
    { "type": "style", "section": "Style", "hidden": false }
  ],
  "commitUrlFormat": "https://github.com/Krzysztof-Cieslak/jev-agent-control/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/Krzysztof-Cieslak/jev-agent-control/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://github.com/Krzysztof-Cieslak/jev-agent-control/issues/{{id}}"
}
